#!/usr/bin/env bash
# Checks .claude-plugin/marketplace.json. Run by CI on every push and pull request.
#
# 1. It parses, and every plugin name is unique.
# 2. It does not list a plugin named "basecamp".
#
# Rule 2 exists because "basecamp@37signals" used to be the CLI plugin, now
# "basecamp-cli". basecamp-cli's `basecamp setup` treats any installed
# basecamp@37signals as that old plugin and uninstalls it (basecamp/basecamp-cli#840).
# Listing the hosted plugin (plugins/basecamp) as "basecamp" now would get it
# uninstalled by setup, and would hand the hosted plugin to anyone still on the
# old CLI install at their next update.
#
# Remove rule 2 only when both hold:
#   - the deprecation window for the old basecamp@37signals name has passed, and
#   - a basecamp-cli release has shipped that no longer treats basecamp@37signals as stale.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
marketplace="$root/.claude-plugin/marketplace.json"

python3 - "$marketplace" <<'PY'
import collections, json, sys

with open(sys.argv[1]) as f:
    names = [p["name"] for p in json.load(f)["plugins"]]

failed = False
for name, count in collections.Counter(names).items():
    if count > 1:
        print(f"error: plugin name {name!r} is listed {count} times", file=sys.stderr)
        failed = True

if "basecamp" in names:
    print(
        "error: the marketplace lists a plugin named 'basecamp'. That name stays unlisted until the\n"
        "old basecamp@37signals deprecation window has passed and a basecamp-cli release no\n"
        "longer treats basecamp@37signals as stale. See bin/check-marketplace.",
        file=sys.stderr,
    )
    failed = True

sys.exit(1 if failed else 0)
PY
echo "marketplace.json OK"
