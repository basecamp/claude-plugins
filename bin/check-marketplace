#!/usr/bin/env bash
# Checks .claude-plugin/marketplace.json and .cursor-plugin/marketplace.json. Run by CI on every push and pull request.
#
# 1. It parses, and every plugin name is unique.
# 2. A plugin named "basecamp", if listed, has exactly the same source as
#    "basecamp-cli": a deprecated alias for it.
# 3. Every plugin in release-pins.json is listed, and its source carries the
#    full sha of a commit (bin/pin-releases), so it installs a released CLI's
#    plugin rather than the default branch.
#
# "basecamp@37signals" used to be the CLI plugin, now "basecamp-cli". During the
# deprecation window the alias keeps existing installs loading, and
# basecamp-cli's `basecamp setup` moves them to basecamp-cli by key: it treats an
# installed basecamp@37signals as the CLI plugin (basecamp/basecamp-cli#840).
# Pointing "basecamp" anywhere else, such as the hosted plugin in
# plugins/basecamp, would swap a different plugin in under existing installs,
# and setup would uninstall it.
#
# Rule 2 changes only in its own PR, once both hold:
#   - the deprecation window has passed (7 days from the CLI release that ships the rename), and
#   - a basecamp-cli release has shipped that no longer treats basecamp@37signals
#     as the old CLI plugin.
# That PR first removes the alias. Pointing "basecamp" at the hosted plugin is a
# later decision still.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
marketplace="$root/.claude-plugin/marketplace.json"

python3 - "$marketplace" "$root/release-pins.json" <<'PY'
import collections, json, re, sys

with open(sys.argv[1]) as f:
    plugins = json.load(f)["plugins"]
with open(sys.argv[2]) as f:
    pins = json.load(f)
names = [p["name"] for p in plugins]

failed = False
for name, count in collections.Counter(names).items():
    if count > 1:
        print(f"error: plugin name {name!r} is listed {count} times", file=sys.stderr)
        failed = True

by_name = {p["name"]: p for p in plugins}
alias = by_name.get("basecamp")
if alias is not None:
    target = by_name.get("basecamp-cli")
    if target is None or alias.get("source") != target.get("source"):
        print(
            "error: the 'basecamp' entry must be a deprecated alias with exactly the same source as\n"
            "'basecamp-cli' until the deprecation window ends and a basecamp-cli release stops\n"
            "treating basecamp@37signals as the old CLI plugin. See bin/check-marketplace.",
            file=sys.stderr,
        )
        failed = True

for name, repo in pins.items():
    plugin = by_name.get(name)
    if plugin is None:
        print(f"error: release-pins.json pins {name!r}, which marketplace.json doesn't list", file=sys.stderr)
        failed = True
    elif not re.fullmatch(r"[0-9a-f]{40}", str(plugin["source"].get("sha", ""))):
        print(
            f"error: {name!r} must be pinned to a release of {repo} by a full commit sha.\n"
            "Run bin/pin-releases. See release-pins.json.",
            file=sys.stderr,
        )
        failed = True

sys.exit(1 if failed else 0)
PY
echo "marketplace.json OK"

# Cursor: .cursor-plugin/marketplace.json parses, names are unique, and each
# source is a folder here whose .cursor-plugin/plugin.json has the same name.
python3 - "$root" <<'PY'
import collections, json, os, sys

root = sys.argv[1]
with open(os.path.join(root, ".cursor-plugin", "marketplace.json")) as f:
    plugins = json.load(f)["plugins"]

failed = False
for name, count in collections.Counter(p["name"] for p in plugins).items():
    if count > 1:
        print(f"error: Cursor plugin name {name!r} is listed {count} times", file=sys.stderr)
        failed = True
for p in plugins:
    manifest = os.path.join(root, p["source"], ".cursor-plugin", "plugin.json")
    if not os.path.isfile(manifest):
        print(f"error: Cursor plugin {p['name']!r}: no {manifest}", file=sys.stderr)
        failed = True
        continue
    with open(manifest) as f:
        if json.load(f)["name"] != p["name"]:
            print(f"error: Cursor plugin {p['name']!r}: plugin.json name differs", file=sys.stderr)
            failed = True

sys.exit(1 if failed else 0)
PY
echo "Cursor marketplace.json OK"
